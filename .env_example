# Octer.ai API Key — get one at https://octer.ai/workspace
# Me → Settings → API Keys → Create Key (starts with `evo_`)
OCTER_API_KEY=evo_your_key_here

# Access control. Octer cloud requests all use the fixed user_id "octer-cloud",
# so a single allowlist entry is enough. Either:
#   1) OCTER_ALLOWED_USERS=octer-cloud      (recommended — explicit allowlist)
#   2) OCTER_ALLOW_ALL_USERS=true           (no allowlist, accept all requests)
OCTER_ALLOWED_USERS=octer-cloud
# OCTER_ALLOW_ALL_USERS=true
